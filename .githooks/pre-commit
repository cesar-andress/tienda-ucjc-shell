#!/usr/bin/env bash
# ABSOLUTO: solo cesar.andress@ucjc.edu como author y committer.
set -euo pipefail
REQUIRED='cesar.andress@ucjc.edu'

email_from_ident() {
  sed -n 's/.*<\([^>]*\)>.*/\1/p'
}

author_email=$(git var GIT_AUTHOR_IDENT 2>/dev/null | email_from_ident || true)
committer_email=$(git var GIT_COMMITTER_IDENT 2>/dev/null | email_from_ident || true)
local_email=$(git config --local --get user.email 2>/dev/null || true)
local_name=$(git config --local --get user.name 2>/dev/null || true)

fail() { echo "pre-commit: $*" >&2; exit 1; }

[[ "$author_email" == "$REQUIRED" ]] || fail "autor debe ser ${REQUIRED} (ahora: '${author_email:-<vacío>}')"
[[ "$committer_email" == "$REQUIRED" ]] || fail "committer debe ser ${REQUIRED} (ahora: '${committer_email:-<vacío>}')"
[[ "$local_email" == "$REQUIRED" ]] || fail "user.email local debe ser ${REQUIRED} (ahora: '${local_email:-<vacío>}')"
[[ -n "${local_name}" ]] || fail "falta user.name local"

case "$author_email$committer_email$local_email$local_name" in
  *aiserv*|*cursor*|*Cursor*|*noreply*)
    fail "identidad prohibida (cursor/aiserv/noreply)"
    ;;
esac
