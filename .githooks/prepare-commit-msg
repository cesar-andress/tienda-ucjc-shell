#!/usr/bin/env bash
# ABSOLUTO: eliminar trailers de herramientas antes de finalizar el mensaje.
set -euo pipefail
msg_file=${1:?}
tmp=$(mktemp)

# Quitar TODO Co-authored-by que no sea cesar.andress@ucjc.edu
grep -viE '^[[:space:]]*Co-authored-by:' "$msg_file" > "$tmp" || true
# Si había una línea UCJC legítima, no la recuperamos: en estos repos no queremos coautores.
# (Un único author cesar.andress@ucjc.edu basta.)

awk 'BEGIN{n=0} {lines[++n]=$0} END{while(n>0 && lines[n]~/^[[:space:]]*$/) n--; for(i=1;i<=n;i++) print lines[i]}' \
  "$tmp" > "$msg_file"
rm -f "$tmp"
